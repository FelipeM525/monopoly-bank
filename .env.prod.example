# =============================================================================
# Production Environment Variables for AWS EC2 + Amazon RDS
# Copy this file to .env on your EC2 instance and fill in your RDS values:
#   cp .env.prod.example .env && chmod 600 .env
# =============================================================================

# Amazon RDS PostgreSQL 16 connection
SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/monopoly
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_RDS_PASSWORD

# Public HTTP port on the EC2 host (default: 80)
FRONTEND_PORT=80

# Optional game rule overrides
GAME_STARTING_BALANCE_CENTS=150000
GAME_SALARY_CENTS=20000
GAME_BANK_INITIAL_CASH_CENTS=2000000
GAME_BANK_UNLIMITED=false
